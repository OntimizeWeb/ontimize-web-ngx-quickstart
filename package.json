{
  "name": "ontimize-web-ngx-quickstart",
  "version": "18.0.0-next.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4800",
    "test": "ng test --code-coverage",
    "test-ci": "ng test --no-watch --code-coverage --browsers ChromeHeadless",
    "lint": "ng lint",
    "build": "ng build",
    "dev": "ng build --configuration production",
    "production": "ng build --configuration production --base-href /v18/quickstart/",
    "production-aot-server": "ng build --configuration production --base-href /ontimizeweb/v18/quickstart/",
    "production-aot-serverpwa": "ng build --configuration production --base-href /ontimizeweb/v18/quickstart/ && npm run build-ngsw",
    "development-aot-serverpwa": "ng build --configuration production --base-href / && npm run build-ngsw",
    "build-ngsw": "npm run build-ngsw-config",
    "build-ngsw-config": "node_modules/.bin/ngsw-config dist ngsw-config.json ontimize-web-ngx-quickstart-pwa"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/cdk": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/material": "^18.2.0",
    "@angular/material-moment-adapter": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/platform-server": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@angular/upgrade": "^18.2.0",
    "luxon": "^3.4.0",
    "moment": "^2.29.4",
    "ontimize-web-ngx": "18.0.0-next.1",
    "ontimize-web-ngx-charts": "18.0.0-next.0",
    "ontimize-web-ngx-extra-components": "18.0.0-next.1",
    "ontimize-web-ngx-filemanager": "18.0.0-next.0",
    "ontimize-web-ngx-map": "18.0.0-next.0",
    "ontimize-web-ngx-report": "18.0.0-next.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular-eslint/builder": "18.4.3",
    "@angular-eslint/eslint-plugin": "18.4.3",
    "@angular-eslint/eslint-plugin-template": "18.4.3",
    "@angular-eslint/schematics": "18.4.3",
    "@angular-eslint/template-parser": "18.4.3",
    "@angular/cli": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@angular/language-service": "^18.2.0",
    "@angular/service-worker": "^18.2.0",
    "@types/jasmine": "~5.1.0",
    "@types/luxon": "^3.4.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "ajv": "^7.2.4",
    "eslint": "^8.56.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.2",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "karma-sonarqube-unit-reporter": "0.0.23",
    "sass": "^1.62.1",
    "sonarqube-scanner": "^2.8.1",
    "ts-node": "~10.9.0",
    "typescript": "~5.5.0"
  }
}
